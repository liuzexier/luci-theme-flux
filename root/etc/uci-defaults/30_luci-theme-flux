#!/bin/sh

theme_mode="$(uci -q get flux.theme.mode)"
theme_primary_color="$(uci -q get flux.theme.primary_color)"
theme_background_light="$(uci -q get flux.theme.background_light)"
theme_background_dark="$(uci -q get flux.theme.background_dark)"
theme_tab_count="$(uci -q get flux.theme.tab_count)"
slot1_source="$(uci -q get flux.slot1.source)"
slot1_menu_path="$(uci -q get flux.slot1.menu_path)"
slot1_custom_path="$(uci -q get flux.slot1.custom_path)"
slot1_legacy_path="$(uci -q get flux.slot1.path)"
slot1_label="$(uci -q get flux.slot1.label)"
slot1_icon="$(uci -q get flux.slot1.icon)"
slot2_source="$(uci -q get flux.slot2.source)"
slot2_menu_path="$(uci -q get flux.slot2.menu_path)"
slot2_custom_path="$(uci -q get flux.slot2.custom_path)"
slot2_legacy_path="$(uci -q get flux.slot2.path)"
slot2_label="$(uci -q get flux.slot2.label)"
slot2_icon="$(uci -q get flux.slot2.icon)"
slot3_source="$(uci -q get flux.slot3.source)"
slot3_menu_path="$(uci -q get flux.slot3.menu_path)"
slot3_custom_path="$(uci -q get flux.slot3.custom_path)"
slot3_legacy_path="$(uci -q get flux.slot3.path)"
slot3_label="$(uci -q get flux.slot3.label)"
slot3_icon="$(uci -q get flux.slot3.icon)"
slot4_source="$(uci -q get flux.slot4.source)"
slot4_menu_path="$(uci -q get flux.slot4.menu_path)"
slot4_custom_path="$(uci -q get flux.slot4.custom_path)"
slot4_label="$(uci -q get flux.slot4.label)"
slot4_icon="$(uci -q get flux.slot4.icon)"
slot4_legacy_path="$(uci -q get flux.slot4.path)"
slot5_source="$(uci -q get flux.slot5.source)"
slot5_menu_path="$(uci -q get flux.slot5.menu_path)"
slot5_custom_path="$(uci -q get flux.slot5.custom_path)"
slot5_label="$(uci -q get flux.slot5.label)"
slot5_icon="$(uci -q get flux.slot5.icon)"
slot5_legacy_path="$(uci -q get flux.slot5.path)"

[ -n "$theme_mode" ] || theme_mode="auto"
[ -n "$theme_primary_color" ] || theme_primary_color="#0f766e"
[ -n "$theme_background_light" ] || theme_background_light="#f7f8fb"
[ -n "$theme_background_dark" ] || theme_background_dark="#101418"
case "$theme_tab_count" in
	1|2|3|4|5) ;;
	*) theme_tab_count="4" ;;
esac
case "$slot1_source" in
	menu|custom) ;;
	*) slot1_source="custom" ;;
esac
case "$slot1_legacy_path" in
	admin|admin/*) slot1_menu_path="${slot1_menu_path:-$slot1_legacy_path}" ;;
esac
[ -n "$slot1_menu_path" ] || slot1_menu_path="admin/quickstart"
if [ -z "$slot1_custom_path" ] && [ "$slot1_source" = "custom" ]; then
	slot1_custom_path="${slot1_legacy_path:-/}"
fi
[ -n "$slot1_custom_path" ] || slot1_custom_path="/"
[ -n "$slot1_label" ] || slot1_label="Home"
[ -n "$slot1_icon" ] || slot1_icon="home"
[ "$slot2_source" = "custom" ] || slot2_source="menu"
[ -n "$slot2_menu_path" ] || slot2_menu_path="${slot2_legacy_path:-admin/services}"
if [ -z "$slot2_custom_path" ] && [ "$slot2_source" = "custom" ]; then
	slot2_custom_path="${slot2_legacy_path:-/}"
fi
[ -n "$slot2_custom_path" ] || slot2_custom_path="/"
[ -n "$slot2_label" ] || slot2_label="服务"
[ -n "$slot2_icon" ] || slot2_icon="services"
[ "$slot3_source" = "custom" ] || slot3_source="menu"
[ -n "$slot3_menu_path" ] || slot3_menu_path="${slot3_legacy_path:-admin/network}"
if [ -z "$slot3_custom_path" ] && [ "$slot3_source" = "custom" ]; then
	slot3_custom_path="${slot3_legacy_path:-/}"
fi
[ -n "$slot3_custom_path" ] || slot3_custom_path="/"
[ -n "$slot3_label" ] || slot3_label="网络"
[ -n "$slot3_icon" ] || slot3_icon="network"
[ "$slot4_source" = "custom" ] || slot4_source="menu"
[ -n "$slot4_menu_path" ] || slot4_menu_path="${slot4_legacy_path:-admin/system}"
if [ -z "$slot4_custom_path" ] && [ "$slot4_source" = "custom" ]; then
	slot4_custom_path="${slot4_legacy_path:-/}"
fi
[ -n "$slot4_custom_path" ] || slot4_custom_path="/"
[ -n "$slot4_label" ] || slot4_label="系统"
[ -n "$slot4_icon" ] || slot4_icon="system"
[ "$slot5_source" = "custom" ] || slot5_source="menu"
[ -n "$slot5_menu_path" ] || slot5_menu_path="${slot5_legacy_path:-admin/status}"
if [ -z "$slot5_custom_path" ] && [ "$slot5_source" = "custom" ]; then
	slot5_custom_path="${slot5_legacy_path:-/}"
fi
[ -n "$slot5_custom_path" ] || slot5_custom_path="/"
[ -n "$slot5_label" ] || slot5_label="状态"
[ -n "$slot5_icon" ] || slot5_icon="status"

uci -q batch <<-EOF >/dev/null
	set luci.themes.Flux=/luci-static/flux
	commit luci
	set flux.theme=appearance
	set flux.theme.mode="$theme_mode"
	set flux.theme.primary_color="$theme_primary_color"
	set flux.theme.background_light="$theme_background_light"
	set flux.theme.background_dark="$theme_background_dark"
	set flux.theme.tab_count="$theme_tab_count"
	delete flux.theme.glass_opacity
	set flux.slot1=menu
	delete flux.slot1.enabled
	set flux.slot1.source="$slot1_source"
	set flux.slot1.menu_path="$slot1_menu_path"
	set flux.slot1.custom_path="$slot1_custom_path"
	set flux.slot1.label="$slot1_label"
	set flux.slot1.icon="$slot1_icon"
	delete flux.slot1.path
	delete flux.slot1.dropdown
	set flux.slot2=menu
	delete flux.slot2.enabled
	set flux.slot2.source="$slot2_source"
	set flux.slot2.menu_path="$slot2_menu_path"
	set flux.slot2.custom_path="$slot2_custom_path"
	set flux.slot2.label="$slot2_label"
	set flux.slot2.icon="$slot2_icon"
	delete flux.slot2.path
	delete flux.slot2.dropdown
	set flux.slot3=menu
	delete flux.slot3.enabled
	set flux.slot3.source="$slot3_source"
	set flux.slot3.menu_path="$slot3_menu_path"
	set flux.slot3.custom_path="$slot3_custom_path"
	set flux.slot3.label="$slot3_label"
	set flux.slot3.icon="$slot3_icon"
	delete flux.slot3.path
	delete flux.slot3.dropdown
	set flux.slot4=menu
	delete flux.slot4.enabled
	set flux.slot4.source="$slot4_source"
	set flux.slot4.menu_path="$slot4_menu_path"
	set flux.slot4.custom_path="$slot4_custom_path"
	set flux.slot4.label="$slot4_label"
	set flux.slot4.icon="$slot4_icon"
	delete flux.slot4.path
	delete flux.slot4.dropdown
	set flux.slot5=menu
	delete flux.slot5.enabled
	set flux.slot5.source="$slot5_source"
	set flux.slot5.menu_path="$slot5_menu_path"
	set flux.slot5.custom_path="$slot5_custom_path"
	set flux.slot5.label="$slot5_label"
	set flux.slot5.icon="$slot5_icon"
	delete flux.slot5.path
	delete flux.slot5.dropdown
	commit flux
EOF

exit 0
